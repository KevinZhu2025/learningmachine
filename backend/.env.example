APP_ENV=development
ADMIN_USER_ID=Admin
ALLOWED_ORIGINS=http://127.0.0.1:5173
IMPORT_MODE=integrated

# 阿里云 RDS SQL Server（杭州 VPC 内网，端口 3433）
# 生产推荐直接使用 DATABASE_URL；密码含特殊字符时必须 URL 编码。
DATABASE_NAME=LearningMachineDB
SQL_SERVER=rm-bp14dc5e96x6k826w.sqlserver.rds.aliyuncs.com
SQL_SERVER_PORT=3433
SQL_SERVER_USER=
SQL_SERVER_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_SERVER_CERTIFICATE=yes
# 或提供完整连接串（优先级最高）：
# DATABASE_URL=mssql+pyodbc://user:encoded-password@rm-bp14dc5e96x6k826w.sqlserver.rds.aliyuncs.com:3433/LearningMachineDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes

# 阿里云 OSS（ECS 内网访问使用 internal Endpoint）
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=learningmachineoss
# ECS 绑定 RAM 角色时配置角色名，无需 AccessKey；本地开发可用 ALICLOUD_ACCESS_KEY_ID/SECRET
ALICLOUD_RAM_ROLE_NAME=LearningMachineRAM
# ALICLOUD_ACCESS_KEY_ID=
# ALICLOUD_ACCESS_KEY_SECRET=

# 火山方舟 Ark（第三方服务，保持不变；密钥通过环境变量或 KMS 注入，不入库不入 Git）
# 注意：/api/plan/v3 是方舟 Agent Plan 个人版订阅端点，官方限制不得用于非 Agent 工具的
# API 调用（有停用/封号风险）；生产建议改用标准 https://ark.cn-beijing.volces.com/api/v3 + 按量付费密钥。
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_VISION_MODEL=ark-code-latest
# 方式一：直接注入密钥（ECS 加密环境变量）
# ARK_API_KEY=
# 方式二：阿里云 KMS 凭据管家（二选一）
# ALICLOUD_KMS_SECRET_NAME=ark-api-key
# ALICLOUD_KMS_ENDPOINT=secretsmanager.cn-hangzhou.aliyuncs.com