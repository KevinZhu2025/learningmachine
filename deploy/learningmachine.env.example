# 服务器运行环境变量（复制为 learningmachine.env 后填写，勿提交真实密钥到 Git）
# systemd 通过 EnvironmentFile 加载本文件。

APP_ENV=production
ADMIN_USER_ID=Admin
# 至少 32 字节随机串，可在服务器执行: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_CSRF_SECRET=
# 备案域名就绪后改为正式 HTTPS Origin，逗号分隔
ALLOWED_ORIGINS=http://8.136.251.167

# 上线建议先 preview，健康检查通过后再切 integrated
IMPORT_MODE=preview

# RDS SQL Server（VPC 内网，端口 3433）
DATABASE_NAME=LearningMachineDB
DATABASE_URL=mssql+pyodbc://APP_USER:URL_ENCODED_PASSWORD@rm-bp14dc5e96x6k826w.sqlserver.rds.aliyuncs.com:3433/LearningMachineDB?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes&LongAsMax=yes

# OSS（ECS 内网 Endpoint + RAM 角色）
OSS_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=learningmachineoss
ALICLOUD_RAM_ROLE_NAME=LearningMachineRAM

# 火山方舟 Ark（密钥二选一，推荐直接注入 ARK_API_KEY）
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_MODEL=ark-code-latest
ARK_VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
ARK_VISION_MODEL=ark-code-latest
# ARK_API_KEY=
# ALICLOUD_KMS_SECRET_NAME=ark-api-key
